# Copy to .env.local and fill in. Without DATABASE_URL the app serves
# labelled placeholder data so the UI works offline.

# Postgres connection string. For a hosted DB (e.g. Neon) SSL is used
# automatically; for a localhost/127.0.0.1 connection src/lib/db.ts disables
# SSL, so a plain local URL works as-is.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Local example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/musea

# Optional token to protect the /api/seed endpoint.
SEED_TOKEN=change-me
